# 白名單模式：先忽略全部，再放行指定路徑
/*
!/.gitignore
!/kolafi/

/kolafi/*
!/kolafi/docker-compose.dev.yml

!/kolafi/kolafi-web/
/kolafi/kolafi-web/*
!/kolafi/kolafi-web/functions/
!/kolafi/kolafi-web/public/
!/kolafi/kolafi-web/server/
!/kolafi/kolafi-web/src/
!/kolafi/kolafi-web/.gitignore
!/kolafi/kolafi-web/Dockerfile.dev
!/kolafi/kolafi-web/env.d.ts
!/kolafi/kolafi-web/index.html
!/kolafi/kolafi-web/package.json
!/kolafi/kolafi-web/package-lock.json
!/kolafi/kolafi-web/tsconfig.json
