!/kolafi/kolafi-web/tsconfig.node.json
!/kolafi/kolafi-web/tsconfig.functions.json
!/kolafi/kolafi-web/tsconfig.worker.json
!/kolafi/kolafi-web/vite.config.ts
!/kolafi/kolafi-web/worker-configuration.d.ts
!/kolafi/kolafi-web/wrangler.jsonc

