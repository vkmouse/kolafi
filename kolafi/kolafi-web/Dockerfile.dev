FROM node:22-bookworm-slim

# psmisc: dev:full 啟動前清殘留 port；curl: docker-compose healthcheck 用
RUN apt-get update && apt-get install -y --no-install-recommends psmisc curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm install

COPY . .

# 11000: Vite（純前端 HMR）；11001: wrangler pages dev proxy，實際開發入口
EXPOSE 11000 11001

ENV NODE_ENV=development

# wrangler pages dev 不繼承 process.env，啟動前轉寫成 .dev.vars 讓它讀到（避免寫死在 wrangler.jsonc）
CMD for key in S3_ENDPOINT S3_REGION S3_ACCESS_KEY_ID S3_SECRET_ACCESS_KEY S3_BUCKET S3_FORCE_PATH_STYLE S3_CF_ACCESS_CLIENT_ID S3_CF_ACCESS_CLIENT_SECRET KOLAFI_WORKER_BASE_URL KOLAFI_WORKER_CF_ACCESS_CLIENT_ID KOLAFI_WORKER_CF_ACCESS_CLIENT_SECRET; do \
      val=$(printenv "$key" 2>/dev/null || true); \
      if [ -n "$val" ]; then echo "$key=\"$val\""; fi; \
    done > .dev.vars && exec npm run dev:full
