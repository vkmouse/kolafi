# --- Cloudflare R2（S3 相容 API）---
# S3_ENDPOINT 格式：https://<ACCOUNT_ID>.r2.cloudflarestorage.com（不要帶 bucket 名稱）
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=kolafi

# --- Cloudflare Access Service Token（web <-> worker 互打用；本地開發留空即可，不會被驗證） ---
KOLAFI_WORKER_CF_ACCESS_CLIENT_ID=
KOLAFI_WORKER_CF_ACCESS_CLIENT_SECRET=
KOLAFI_API_CF_ACCESS_CLIENT_ID=
KOLAFI_API_CF_ACCESS_CLIENT_SECRET=

ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
APP_JWT_SECRET=

# --- OAuth Server / MCP ---
# 簽發與驗證 OAuth access token 用，跟 APP_JWT_SECRET 分開，兩者不可相同
OAUTH_JWT_SECRET=
# 選填：固定本站對外網址（例如 https://example.com，結尾不帶斜線），用於探索 metadata、
# resource 比對與 access token 的 aud；留空就用請求本身的網址
PUBLIC_ORIGIN=

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=

# --- Web Sandbox ---
WEB_SANDBOX_BASE_URL=
WEB_SANDBOX_TOKEN=
WEB_SANDBOX_PROFILE_ID=
