# --- Cloudflare R2（S3 相容 API）---
# S3_ENDPOINT 格式：https://<ACCOUNT_ID>.r2.cloudflarestorage.com（不要帶 bucket 名稱）
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=kolafi

# --- Cloudflare Access Service Token（web <-> worker 互打用；本地開發留空即可，不會被驗證） ---
KOLAFI_WORKER_CF_ACCESS_CLIENT_ID=
KOLAFI_WORKER_CF_ACCESS_CLIENT_SECRET=
KOLAFI_API_CF_ACCESS_CLIENT_ID=
KOLAFI_API_CF_ACCESS_CLIENT_SECRET=

ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
APP_JWT_SECRET=

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=

# --- Web Sandbox ---
WEB_SANDBOX_BASE_URL=
WEB_SANDBOX_TOKEN=
WEB_SANDBOX_PROFILE_ID=
